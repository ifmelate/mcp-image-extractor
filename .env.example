# Maximum input image size in bytes (default: 10MB)
MAX_IMAGE_SIZE=10485760

# Comma-separated domain whitelist for URL extraction (default: empty = all allowed)
ALLOWED_DOMAINS=

# Maximum dimension (width or height) for resized images (default: 512)
MAX_IMAGE_DIMENSION=512

# Timeout for URL fetches in milliseconds (default: 30000)
URL_FETCH_TIMEOUT_MS=30000
